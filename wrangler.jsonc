{
  "name": "panen-ai",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./cf-public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/admin.html",
      "/admin_login.html"
    ]
  },
  "vars": {
    "SUPABASE_BUCKET": "panen-ai-uploads",
    "GITHUB_REPO": "MuhamadHata/PANEN-AI"
  }
}
