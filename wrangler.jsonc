{
  "name": "panen-ai",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./cf-public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "vars": {
    "BACKEND_URL": "https://hatzu-panen-ai.hf.space"
  },
  "triggers": {
    "crons": [
      "0 */12 * * *"
    ]
  }
}
